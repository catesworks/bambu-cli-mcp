{
  "name": "bambu-cli-mcp",
  "version": "0.1.0",
  "description": "MCP servers for BambuStudio CLI orchestration and CAD geometry operations",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bambu-cli-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "bundle": "bun build src/index.ts --compile --outfile bambu-cli-mcp",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "bambu",
    "3d-printing",
    "slicer",
    "bambu-studio"
  ],
  "author": "Andrew Cates",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/catesworks/bambu-cli-mcp.git"
  },
  "homepage": "https://bambu-cli-mcp-docs.vercel.app",
  "bugs": {
    "url": "https://github.com/catesworks/bambu-cli-mcp/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "execa": "^9.6.1",
    "manifold-3d": "^3.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
